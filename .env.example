# Claude (Anthropic) — opcjonalne wzbogacenie Smart Autopilot: bez klucza appka dziala w 100%
# na heurystykach/szablonach (zero-config, domyslne zachowanie); z kluczem dostaje prawdziwie
# generowane per-platforma captiony/hashtagi (lib/server/smart-autopilot/ai-content.ts) i
# doprecyzowanie klasyfikacji persona/intent (lib/server/smart-autopilot/llm.ts, tylko tryb
# ai-autopilot, plan PRO). Klucz z platform.claude.com.
ANTHROPIC_API_KEY=""
# Opcjonalne nadpisanie modeli (patrz lib/server/anthropic-client.ts dla domyslnych):
# ANTHROPIC_CLASSIFICATION_MODEL="claude-haiku-4-5-20251001"
# ANTHROPIC_CONTENT_MODEL="claude-sonnet-5"

# Telegram — warstwa kontroli (TASK-3.1.1). Bota zakładasz u @BotFather (/newbot), webhook
# ustawiasz przez setWebhook z parametrem secret_token=TELEGRAM_WEBHOOK_SECRET - patrz
# docs/postfly-instrukcja-startu.md.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_BOT_USERNAME=""

# Sentry — error monitoring (see C w GO_LIVE_PLAN.md). Puste = SDK wyłączony (brak wysyłki zdarzeń).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Opcjonalne, tylko do uploadu source mapów przy buildzie (Sentry → Settings → Auth Tokens):
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Upstash QStash — precyzyjny harmonogram publikacji bez trzymania wlasnego procesu-workera
# (Vercel Functions sa bezstanowe, nie da sie tam odpalic BullMQ). Bez klucza appka dziala jak
# dotychczas — zaplanowany post czeka na dzienny cron Vercela (/api/cron/publish); z kluczem
# QStash wola endpoint dokladnie o zaplanowanej godzinie. Klucze z upstash.com (ten sam panel co
# Upstash Redis powyzej, jesli juz go masz).
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
# Opcjonalne - tylko jesli Twoja instancja QStash jest regionalna (np. eu-central-1) i wymaga
# wlasnego endpointu zamiast globalnego domyslnego z SDK. Puste = SDK uzywa swojego defaultu.
QSTASH_URL=""
