NEXT_PUBLIC_API_URL="/api"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowstate?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/flowstate?schema=public"
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

JWT_SECRET="replace-with-strong-jwt-secret"
JWT_EXPIRES_IN="3600"
ENCRYPTION_KEY="replace-with-strong-encryption-key"
OAUTH_STATE_SECRET="replace-with-strong-oauth-state-secret"
CRON_SECRET="replace-with-strong-cron-secret"
TIKTOK_WEBHOOK_SECRET="replace-with-strong-tiktok-webhook-secret"
APP_MODE="personal"
# personal    = appka tylko dla Ciebie: rejestracja zamknięta po 1. koncie, brak limitów planu,
#               billing/Stripe ukryty w UI. Bezpieczny default.
# commercial  = pełny tryb wielu klientów: rejestracja otwarta, limity planu i Stripe aktywne
#               dokładnie tak jak dziś w kodzie — włącz dopiero gdy appka ma płacących userów (JDG).
NEXT_PUBLIC_APP_MODE="personal"
# Publiczny odpowiednik APP_MODE dla komponentów klienckich (przeglądarka nie widzi zmiennych
# bez prefiksu NEXT_PUBLIC_). Trzymaj zsynchronizowane z APP_MODE powyżej.

BILLING_MODE="auto"
BILLING_CHECKOUT_URL=""
BILLING_PORTAL_URL=""
RESEND_API_KEY=""
EMAIL_FROM="PostFly <hello@postfly.pl>"
PASSWORD_RESET_TOKEN_TTL_MIN="30"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_YEARLY=""
