# TASK-1.1.1: konfiguracja środowiska testowego (Vitest + serwer e2e pod NODE_ENV=test).
# Skopiuj do .env.test i nie zmieniaj sekretów OAuth - muszą zostać puste, żeby żadna
# ścieżka kodu w testach nie miała czym połączyć się z prawdziwą platformą. Dodatkowo
# lib/server/test-network-guard.ts blokuje same połączenia sieciowe do tych hostów,
# niezależnie od tego, co tu wpiszesz - to jest druga, niezależna warstwa ochrony.

NODE_ENV="test"
NEXT_PUBLIC_API_URL="/api"

# Osobna baza, fizycznie inna od bazy deweloperskiej (flowstate) - patrz docker/init-test-db.sql.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowstate_test?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/flowstate_test?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_SECRET="test-only-not-a-real-secret"
JWT_EXPIRES_IN="3600"
ENCRYPTION_KEY="test-only-not-a-real-encryption-key"
OAUTH_STATE_SECRET="test-only-not-a-real-oauth-state-secret"
CRON_SECRET="test-only-not-a-real-cron-secret"
TIKTOK_WEBHOOK_SECRET="test-only-not-a-real-tiktok-webhook-secret"

APP_MODE="personal"
NEXT_PUBLIC_APP_MODE="personal"
BILLING_MODE="mock"

FRONTEND_URL="http://localhost:3000"

# Celowo puste w środowisku testowym - żadna z tych wartości nigdy nie ma być prawdziwym
# sekretem, niezależnie od tego, co deweloper trzyma w .env/.env.local do ręcznych testów.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
GOOGLE_LOGIN_CLIENT_ID=""
GOOGLE_LOGIN_CLIENT_SECRET=""
GOOGLE_LOGIN_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
YT_CLIENT_ID=""
YT_CLIENT_SECRET=""
YT_REDIRECT_URI=""

TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI=""
TIKTOK_KEY=""
TIKTOK_SECRET=""
TIKTOK_OAUTH_SCOPES="user.info.profile,user.info.stats,video.list,video.publish,video.upload"

FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_REDIRECT_URI=""
FACEBOOK_OAUTH_SCOPES="public_profile,email,pages_show_list,pages_manage_posts,pages_read_engagement"

INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
INSTAGRAM_REDIRECT_URI=""
INSTAGRAM_OAUTH_SCOPES="instagram_basic,instagram_content_publish,pages_show_list,business_management"

META_GRAPH_API_VERSION="v23.0"

TELEGRAM_BOT_TOKEN="test-only-not-a-real-telegram-bot-token"
TELEGRAM_WEBHOOK_SECRET="test-only-not-a-real-telegram-webhook-secret"
TELEGRAM_BOT_USERNAME=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RESEND_API_KEY=""

SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
