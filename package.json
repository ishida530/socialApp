{
  "name": "postfly-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -H 0.0.0.0 -p 3000",
    "dev:turbo": "next dev --turbopack -H 0.0.0.0 -p 3000",
    "build": "prisma generate --schema prisma/schema.prisma && next build",
    "build:test": "cross-env NODE_ENV=test prisma generate --schema prisma/schema.prisma && cross-env NODE_ENV=test next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "start:test": "cross-env NODE_ENV=test next start",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:test": "node --env-file=.env.test node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma",
    "test": "npm run test:personal && npm run test:commercial",
    "test:personal": "cross-env APP_MODE=personal vitest run",
    "test:commercial": "cross-env APP_MODE=commercial vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "backup:db": "node scripts/backup-database.mjs",
    "restore:db": "node scripts/restore-database.mjs"
  },
  "dependencies": {
    "@popperjs/core": "2.11.8",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-aspect-ratio": "1.1.15",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-hover-card": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-menubar": "1.1.24",
    "@radix-ui/react-navigation-menu": "1.2.22",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle": "1.1.18",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@react-email/render": "^2.0.4",
    "@sentry/nextjs": "^10.75.0",
    "@upstash/qstash": "^2.11.3",
    "@vercel/blob": "^2.3.0",
    "axios": "^1.13.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "framer-motion": "^12.35.0",
    "google-auth-library": "^10.6.1",
    "input-otp": "1.5.0",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "0.575.0",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "pg": "^8.19.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-resizable-panels": "4.12.4",
    "recharts": "3.10.1",
    "resend": "^6.28.1",
    "sonner": "2.0.8",
    "stripe": "^20.4.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "25.3.3",
    "@types/pg": "^8.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "^10.1.0",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
