generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  YOUTUBE
  INSTAGRAM
  TIKTOK
  FACEBOOK
  // 2026-09-16: drugie konto testowe (biuro nieruchomości), profil osobisty (scope
  // w_member_social - "Share on LinkedIn"), nie strona firmowa (Community Management API
  // wymagałby osobnej, restrykcyjnej recenzji LinkedIn). Publikacja tylko tekst/zdjęcia - LinkedIn
  // wymaga bezpośredniego uploadu bajtów (nie pull przez file_url jak Meta), wideo świadomie poza
  // zakresem tej integracji.
  LINKEDIN
}

enum VideoStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum MediaType {
  VIDEO
  IMAGE
  // Proactive content suggestions (2026-09-14): a Facebook-only, media-less status post -
  // Facebook's Graph API is the one platform of the four that accepts a plain /feed post with
  // just a message, no attached video/image (Instagram/TikTok/YouTube all structurally require
  // media). Never produced by a Telegram media upload - only by generateFacebookTextPostSuggestion
  // (lib/server/content-suggestions.ts), attached to a placeholder Video row with no real file.
  TEXT
}

enum PublishStatus {
  DRAFT
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELED
}

enum PlanTier {
  FREE
  STARTER
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

enum CommentStatus {
  PENDING
  REPLIED
  IGNORED
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String
  passwordHash   String?
  defaultExplicitContent Boolean?
  // One free-text sentence or two describing what this account is FOR (e.g. "Jestem raperem,
  // publikuję freestyle", "Prowadzę salon kosmetyczny, paznokcie i rzęsy") - threaded into the
  // Claude content-generation prompt (lib/server/smart-autopilot/ai-content.ts) so tone/style
  // adapts to the actual account instead of assuming every user is a musician. Asked once at
  // onboarding (web account settings, or Telegram after /start if still empty), editable anytime.
  businessDescription String?
  // 2026-09-16 (zgłoszenie właściciela: sugestia treści brzmiała "pizdowato", zbyt generycznie-
  // motywacyjnie dla jego konta - businessDescription mówi CZYM zajmuje się konto, ale nic nie
  // mówi JAK ta osoba mówi). Wolny tekst opisujący głos/ton wypowiedzi (np. "bezpośrednio, bez
  // lania wody, czasem ostro, nie mówię 'buduję markę'") - wpięty w te same prompty Claude co
  // businessDescription (patrz każde miejsce z "accountContext" w lib/server/*), więc jedna
  // zmiana poprawia WSZYSTKIE miejsca generujące treść naraz, nie tylko sugestie na Facebooka.
  communicationStyle String?
  // 2026-09-25: the account owner's own writing rules per platform ({ "FACEBOOK": "...",
  // "LINKEDIN": "...", ... }) - Postfly serves very different businesses (real estate, solar/
  // electrical contractors, artists), so what "a good LinkedIn post" means is the user's call, not
  // a hardcoded prompt. Overrides the generic per-platform tone in every generator that writes
  // platform copy (smart-autopilot bundles, external content intake). Validation and prompt
  // formatting: lib/server/platform-style-guides.ts.
  platformStyleGuides Json?
  // Always kept in generated hashtag sets (e.g. "#pryzmatnieruchomosci"), even when trimming to a
  // platform's limit.
  brandHashtag   String?
  telegramChatId String?         @unique
  publishingPaused Boolean       @default(false)
  // Set while the bot is waiting for a free-text reply answering the onboarding
  // businessDescription question (see handleStartCommand) - same free-text-turn pattern as
  // telegramEditingJobId below.
  telegramAwaitingBusinessDescription Boolean @default(false)
  // Set while the bot is waiting for a free-text reply to edit one DRAFT job's title/caption/
  // hashtags (see handleEditReply in the Telegram webhook) - not a hard FK, the job may be
  // published/canceled/deleted before the reply arrives, checked defensively at lookup time.
  telegramEditingJobId String?
  // Set while the bot is waiting for a free-text reply to schedule a post ("📅 Zaplanuj" ->
  // handleScheduleReply). Same pattern/caveats as telegramEditingJobId, but keyed on postGroupId
  // (a schedule applies to the whole post, not one platform's job).
  telegramSchedulingPostGroupId String?
  // TASK-3.2.3: last time the "long inactivity" nudge was sent, so it doesn't repeat every day
  // once triggered - see lib/server/telegram-notifications.ts (sendInactivityNudges).
  lastInactivityNudgeSentAt DateTime?
  // EPIC 5 (TASK-5.4.3): last time the reach-growth sponsorship signal was sent - same
  // once-per-cooldown pattern as lastInactivityNudgeSentAt, see sendSponsorshipSignals.
  lastSponsorshipSignalSentAt DateTime?
  // Real coaching (2026-09-14): last proactive weekly check-in - same cooldown pattern as the
  // two fields above, see sendWeeklyCoachingCheckins in lib/server/telegram-notifications.ts.
  lastCoachingCheckinSentAt DateTime?
  // Campaigns (2026-09-14): the "current" campaign - every new post created while this is set
  // gets auto-attached (see attachActiveCampaignToJobs in lib/server/campaigns.ts), zero extra
  // step per upload. Starting a new campaign auto-ends whichever one was active. Nullable, not
  // required - most posts belong to no campaign at all.
  activeCampaignId String?
  activeCampaign   Campaign? @relation("ActiveCampaign", fields: [activeCampaignId], references: [id], onDelete: SetNull)
  // Last time the "still running this campaign?" reminder fired for a long-running active
  // campaign - same cooldown-field pattern as the nudges above.
  lastCampaignReminderSentAt DateTime?
  // TASK-9.2 (2026-09-15): last time the "link your Telegram bot" re-engagement email was sent to
  // a user who registered on web but never linked telegramChatId - these users get zero proactive
  // nudges otherwise (every other reminder in telegram-notifications.ts requires telegramChatId).
  // Same once-per-cooldown pattern as the fields above, just over email instead of Telegram.
  lastTelegramLinkReminderSentAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  socialAccounts SocialAccount[]
  videos         Video[]
  integrationKeys IntegrationKey[]
  subscription   Subscription?
  usageCounters  UsageCounter[]
  passwordResetTokens PasswordResetToken[]
  telegramLinkCodes   TelegramLinkCode[]
  agentConversationTurns AgentConversationTurn[]
  fans                   Fan[]
  sales                  Sale[]
  fanSubscriptions       FanSubscription[]
  royaltyRegistrations   RoyaltyRegistration[]
  syncPitches            SyncPitch[]
  goals                  Goal[]
  campaigns              Campaign[] @relation("UserCampaigns")
  socialComments         SocialComment[]
  // EPIC 11 Sprint 11.2 (2026-09-14): set while the bot is waiting for a free-text reply to the
  // "✏️ Napisz własną" button on a detected comment - same free-text-turn pattern as
  // telegramEditingJobId/telegramSchedulingPostGroupId above.
  telegramReplyingToCommentId String?
  // Autopilot (2026-09-14): opt-in, per-user. When true, a new media upload on Telegram skips the
  // manual "Publikuj" tap and is auto-scheduled at the data-driven optimal time per platform
  // (PublishJob.suggestedScheduledFor) instead - UNLESS orchestrateContent flagged a critical
  // safety issue, or a platform is missing a required field (e.g. TikTok privacy level not yet
  // set), in which case that platform still falls back to the normal manual-approval preview.
  // Off by default - "brak reakcji = nie publikuj" stays the default posture for every account
  // that hasn't explicitly opted in.
  autopilotEnabled Boolean @default(false)
  // Proactive content suggestions (2026-09-14): last time the agent sent an unprompted "here's a
  // ready post" (Facebook text) or content-idea nudge - same cooldown-field pattern as every other
  // proactive nudge in this app (lastInactivityNudgeSentAt etc.), see sendContentSuggestions in
  // lib/server/telegram-notifications.ts.
  lastContentSuggestionSentAt DateTime?
  // EPIC 9 TASK-9.3 (2FA, 2026-09-15). twoFactorSecretEncrypted is the ACTIVE secret (only set
  // once setup is confirmed with a real code) - AES-256-GCM, same pattern as OAuth tokens
  // (lib/server/crypto.ts). twoFactorPendingSecretEncrypted holds a secret generated during setup
  // but not yet confirmed, kept separate so starting setup never overwrites/breaks an already-
  // active 2FA config, and an abandoned setup attempt never silently enables anything.
  // twoFactorBackupCodeHashes are one-time-use recovery codes (scrypt-hashed, same as
  // passwordHash) - each is removed from the array the moment it's used.
  twoFactorEnabled              Boolean   @default(false)
  twoFactorSecretEncrypted      String?
  twoFactorPendingSecretEncrypted String?
  twoFactorBackupCodeHashes     String[]  @default([])
  twoFactorTrustedDevices       TwoFactorTrustedDevice[]
}

model TelegramLinkCode {
  id        String    @id @default(cuid())
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

// 2FA "remember this device" (2026-09-16, requested by owner - typing a code on every single
// login was too much friction). Separate from the session cookie/JWT entirely - this only ever
// lets POST /api/auth/login skip straight to a real session instead of returning
// requiresTwoFactor, and ONLY after the password already checked out. It never substitutes for
// the password. Same tokenHash pattern as PasswordResetToken/TelegramLinkCode (raw random token
// in the cookie, sha256 hash stored here) so a leaked DB row alone can't be replayed as a cookie.
model TwoFactorTrustedDevice {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model SocialAccount {
  id           String       @id @default(cuid())
  platform     Platform
  handle       String
  externalId   String?
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishJobs  PublishJob[]
  // "Sticky" last-used per-platform settings: written whenever a draft PATCH saves one of
  // these fields, read when a NEW draft is created (web or Telegram) so Telegram - which has
  // no UI for these settings - inherits what the user last chose in the web composer, instead
  // of a hardcoded default every time.
  lastTiktokPrivacyLevel String?
  lastTiktokAllowComment Boolean?
  lastTiktokAllowDuet    Boolean?
  lastTiktokAllowStitch  Boolean?
  lastMetaPostFormat     String?
  growthSnapshots        AccountGrowthSnapshot[]

  @@index([userId])
  @@unique([platform, externalId])
}

model Video {
  id           String       @id @default(cuid())
  title        String
  description  String?
  tags         String[]     @default([])
  sourceUrl    String
  localPath    String?
  thumbnailUrl String?
  durationSec  Int?
  mediaType    MediaType    @default(VIDEO)
  status       VideoStatus  @default(UPLOADED)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishJobs  PublishJob[]
  // External content intake (2026-09-23, app/api/external/content-intake): "BLOG_POST" | "LISTING" -
  // which external system produced this announcement, null for a normal user upload. sourceRef is
  // the caller's own stable id for the source item (e.g. "blog:{slug}", "asari-{listingId}") - the
  // uniqueness constraint IS the idempotency guard against a retried webhook/cron sync creating a
  // second post for the same article/listing. Postgres unique index allows any number of NULL rows,
  // so ordinary (non-external) videos are unaffected. 2026-09-25: scoped per user - two different
  // customers' sites may legitimately use the same id ("blog:cennik").
  sourceKind   String?
  sourceRef    String?

  @@unique([userId, sourceRef])
  @@index([userId])
}

// 2026-09-25: per-account API keys for server-to-server integrations (a customer's own website
// pushing "new article"/"new offer" into POST /api/external/content-intake). The key decides WHICH
// account receives the drafts - with that account's social accounts and writing settings - so one
// Postfly deployment serves many businesses. Only a SHA-256 hash is stored; the plaintext is shown
// exactly once at creation (same posture as GitHub/Stripe keys).
model IntegrationKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  // First characters of the plaintext, shown in the UI so the owner can tell keys apart.
  keyPrefix  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
}

model PublishJob {
  id              String        @id @default(cuid())
  status          PublishStatus @default(PENDING)
  postGroupId     String
  caption         String        @default("")
  hashtags        String[]      @default([])
  title           String?
  mentions        String[]      @default([])
  isExplicit      Boolean?
  contentWarnings String[]      @default([])
  tiktokPrivacyLevel String?
  tiktokAllowComment Boolean?
  tiktokAllowDuet    Boolean?
  tiktokAllowStitch  Boolean?
  tiktokConsentAt    DateTime?
  metaPostFormat  String?
  // Telegram-only: per-platform toggle on the preview message's inline keyboard, before the
  // final Publikuj tap. Not exposed in the web composer (that has its own platform checkboxes
  // in ScheduleStep that act immediately, no separate "excluded" state to persist).
  excludedFromPublish Boolean   @default(false)
  // Set when a genuinely-scheduled (not publishNow) job gets a precise QStash callback
  // scheduled for it (lib/server/qstash.ts) - null if QStash isn't configured or the call
  // failed, in which case the daily Vercel cron fallback is the only trigger, same as before
  // this feature existed. Used to cancel the pending QStash message if the job is canceled.
  qstashMessageId String?
  scheduledFor    DateTime
  publishedAt     DateTime?
  remotePostId    String?
  remotePostUrl   String?
  errorMessage    String?
  // TASK-3.2.2: null until the user has been told about this job's terminal outcome via
  // Telegram - a FAILED job is notified immediately (never batched, see
  // lib/server/telegram-notifications.ts), a SUCCESS job waits for the next morning digest
  // sweep. Jobs published from the web (no linked telegramChatId) still get marked, just never
  // actually notified - notifyJobFailedImmediately/sendMorningDigest both no-op silently when
  // there's no chat to send to.
  notifiedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  videoId         String
  socialAccountId String
  video           Video         @relation(fields: [videoId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  postMetric      PostMetric?
  // Campaigns (2026-09-14): auto-attached at creation time from User.activeCampaignId when one
  // is set (see attachActiveCampaignToJobs) - null for the common case of a post with no
  // campaign. onDelete: SetNull, not Cascade - deleting a campaign should never delete the posts
  // that were part of it.
  campaignId      String?
  campaign        Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  socialComments  SocialComment[]
  // Autopilot / data-driven scheduling (2026-09-14): the per-platform optimal time computed by
  // optimizeSchedule at draft-creation time (lib/server/smart-autopilot/schedule.ts), persisted
  // here so a LATER action (the "🎯 Zaplanuj optymalnie" button, or autopilot mode) can actually
  // use it - previously this suggestion was shown as one line of text in the preview message and
  // then discarded, never actionable. Null when orchestration failed entirely (rare, no
  // suggestion to give).
  suggestedScheduledFor DateTime?

  @@index([videoId])
  @@index([socialAccountId])
  @@index([status, scheduledFor])
  @@index([postGroupId])
  @@index([status, notifiedAt])
  @@index([campaignId])
}

// EPIC 11 Sprint 11.2 (2026-09-14): a comment detected on one of this app's own published posts
// (Instagram/Facebook only for now - TikTok's comment-read API is gated to a separate Research
// API tier per TASK-11.2.2, not available to a normal app; YouTube/DM out of scope for this pass,
// see backlog). Deliberately scoped to comments on PublishJob-tracked posts only (reuses
// remotePostId, same as PostMetric) rather than enumerating every post on the connected account -
// this app only ever needs to react to comments on what IT published.
// TASK-11.2.7: text is always DATA read by a human via Telegram buttons or passed as user content
// to Claude for a reply suggestion - never interpreted as an instruction to this app or to Claude
// (see SUGGEST_REPLY_SYSTEM_PROMPT in lib/server/social-comments.ts).
model SocialComment {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishJobId      String
  publishJob        PublishJob    @relation(fields: [publishJobId], references: [id], onDelete: Cascade)
  platform          Platform
  externalCommentId String
  authorName        String?
  text              String
  status            CommentStatus @default(PENDING)
  suggestedReply    String?
  telegramChatId    String?
  telegramMessageId Int?
  detectedAt        DateTime      @default(now())
  repliedAt         DateTime?

  @@unique([publishJobId, externalCommentId])
  @@index([userId, status])
}

// Latest known engagement snapshot for one published post, fetched read-only from each
// platform's own API (lib/server/post-metrics.ts) - a real metrics prerequisite before any
// AI-driven "what to improve" suggestion can honestly claim to know what performs well. One row
// per PublishJob (upserted on every sweep), not a time series - a trend history can be added
// later if a feature actually needs it, YAGNI for now.
model PostMetric {
  id           String     @id @default(cuid())
  publishJobId String     @unique
  publishJob   PublishJob @relation(fields: [publishJobId], references: [id], onDelete: Cascade)
  views        Int?
  likes        Int?
  comments     Int?
  shares       Int?
  fetchedAt    DateTime   @default(now())
  createdAt    DateTime   @default(now())
}

// EPIC 11 Sprint 11.1 (2026-09-14): account-level growth, distinct from PostMetric (per-post).
// Unlike PostMetric (one upserted row per post - only the latest snapshot matters), this is
// deliberately a TIME SERIES - one new row per account per daily sweep, never upserted - because
// "growth" only means anything as a trend (this week vs last week), which needs history, not a
// single latest number. Zero new OAuth scopes needed - TikTok (user.info.stats), Instagram
// (instagram_basic), Facebook (pages_read_engagement), YouTube (youtube.readonly) all already
// cover the fields used here; verified against each platform's current docs before building.
model AccountGrowthSnapshot {
  id              String        @id @default(cuid())
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  followerCount   Int
  fetchedAt       DateTime      @default(now())
  createdAt       DateTime      @default(now())

  @@index([socialAccountId, fetchedAt])
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   PlanTier           @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  provider               String             @default("mock")
  providerCustomerId     String?
  providerSubscriptionId String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([plan, status])
}

model UsageCounter {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric      String
  periodStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, metric, periodStart])
  @@index([userId, metric])
}

// Agent-mentor (Telegram): persisted turn history so the conversation has memory across
// requests (each webhook call is a fresh, stateless Vercel Function invocation). Only ever
// plain-text user/assistant turns - the tool_use/tool_result exchange within a single turn stays
// in-memory for that request only (see lib/server/telegram-mentor-agent.ts), never persisted, so
// this table never needs to round-trip anything but strings.
model AgentConversationTurn {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   String
  content String
  // Monotonic insertion order - createdAt alone isn't reliable for ordering here: two turns
  // (user + assistant) are written back-to-back fast enough that a fast/colocated Postgres can
  // give them the identical timestamp (observed in CI, not locally), making createdAt-based
  // ordering non-deterministic. autoincrement() guarantees correct order regardless of clock
  // resolution.
  seq       Int      @default(autoincrement())
  createdAt DateTime @default(now())

  @@index([userId, seq])
}

// EPIC 5 (Monetyzacja) - fundament danych (TASK-5.1.1). Kontakty i sprzedaż NIEZALEŻNE od platform
// social media - jeśli konto TikTok/Instagram zniknie, ta lista zostaje, dokładnie zgodnie z
// zasadą "budowanie listy własnych fanów" z opisu produktu.
//
// Świadomy zakres tej sesji (decyzja PO 2026-09-13, uzasadnienie w log ról): Fan/Sale rejestrowane
// RĘCZNIE przez twórcę (komendy /fan, /sale na Telegramie) - PEŁNA automatyzacja (płatny checkout,
// webhook prawdziwego procesora płatności, rekurencyjne subskrypcje superfanów) wymaga własnego
// konta procesora płatności (np. Stripe Connect) należącego do twórcy, którego appka nie ma i nie
// może samodzielnie założyć - to decyzja biznesowa/finansowa twórcy, ta sama kategoria co decyzja
// o wydawaniu prawdziwych pieniędzy już wcześniej ustalona w tym projekcie jako wymagająca
// jawnej zgody z pokazaną kwotą, nie coś do zdecydowania za kogoś. FanSubscription/
// RoyaltyRegistration/SyncPitch to fundament (modele) gotowy pod przyszłą pełną automatyzację,
// bez migracji od zera - logika agentów nad nimi (Sprint 5.3) świadomie NIE zbudowana teraz,
// bo wymaga realnych danych (prawa autorskie, umowy) których appka nie ma i nie może zgadywać.
model Fan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  name      String?
  source    String   @default("manual")
  createdAt DateTime @default(now())
  sales         Sale[]
  subscriptions FanSubscription[]

  @@unique([userId, email])
  @@index([userId])
}

model Sale {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fanId       String?
  fan         Fan?     @relation(fields: [fanId], references: [id], onDelete: SetNull)
  product     String
  amountCents Int
  currency    String   @default("PLN")
  // How this row was created - "manual" (twórca sam wpisuje przez /sale) is the only value
  // produced by any code path today; "stripe"/other reserved for a future real payment webhook.
  recordedVia String   @default("manual")
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// Model gotowy pod przyszłą logikę rekurencyjnych subskrypcji (Agent superfanów, TASK-5.3.1) -
// żadna appka dziś nie tworzy tu wierszy, brak podpiętego billingu.
model FanSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fanId      String
  fan        Fan       @relation(fields: [fanId], references: [id], onDelete: Cascade)
  tier       String
  status     String    @default("ACTIVE")
  startedAt  DateTime  @default(now())
  canceledAt DateTime?

  @@index([userId])
}

// Model gotowy pod przyszłą logikę Agenta tantiem (TASK-5.3.2) - appka dziś nie tworzy tu wierszy,
// wymaga realnych danych o prawach/splitach od twórcy.
model RoyaltyRegistration {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workTitle    String
  splits       Json
  registeredAt DateTime @default(now())
  notes        String?

  @@index([userId])
}

// Model gotowy pod przyszłą logikę Agenta sync (TASK-5.3.3) - appka dziś nie tworzy tu wierszy.
// rightsConfirmed to twardy blok już zapisany w planie: bez potwierdzonych 100% praw żaden przyszły
// kod nie może pitchować tego utworu dalej.
model SyncPitch {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workTitle       String
  pitchedTo       String
  rightsConfirmed Boolean  @default(false)
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now())

  @@index([userId])
}

// Real coaching (2026-09-14): free-text goal the user set for themselves, same "let the LLM
// handle nuance, don't force a rigid metric enum" philosophy as User.businessDescription. Read
// by the weekly coaching check-in (lib/server/coaching.ts) and settable either via Telegram
// commands (/goal, /goals, /goal-done) or directly in conversation with the agent-mentor
// (set_goal/get_goals/complete_goal tools) - same safe-write-tool exception as Fan/Sale.
model Goal {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  createdAt   DateTime  @default(now())
  achievedAt  DateTime?

  @@index([userId])
}

// Campaigns (2026-09-14): a named push (e.g. "Premiera singla") spanning several posts over
// days/weeks, so results can be reported collectively instead of post-by-post. PO/Architekt/UX
// decision (user deferred to judgment): "active campaign" model - starting one auto-attaches
// every subsequent post with zero extra step, no per-upload tagging prompt. See
// lib/server/campaigns.ts.
model Campaign {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("UserCampaigns", fields: [userId], references: [id], onDelete: Cascade)
  name        String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  publishJobs PublishJob[]
  activeForUsers User[] @relation("ActiveCampaign")

  @@index([userId])
}

model StripeEvent {
  id        String   @id
  type      String
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
}

// EPIC 8 TASK-8.3 (Agent kosztow/FinOps, 2026-09-15): Claude is the only paid component of this
// app (standing constraint since EPIC 5), but there was never any visibility into what it
// actually costs - flagged repeatedly across this project's whole build history as a known gap.
// One row per successful Claude API call, recorded best-effort by callClaudeTool/
// callClaudeAgentTurn (lib/server/anthropic-client.ts) - never blocks or fails the calling
// feature if recording itself fails. `scope` identifies which feature made the call (e.g.
// "coaching", "content-suggestions") so cost can be broken down by feature, not just totalled.
// EPIC 1 TASK-1.5.3 / EPIC 9 TASK-9.3 (audit trail, 2026-09-15): a real dziennik akcji - who did
// what, when, with what result - separate from error_log/observability.ts (which logs to stdout/
// Vercel/Sentry, not queryable by the app itself). Scoped deliberately to SECURITY-relevant events
// for this first pass (login, 2FA, account deletion, password reset) rather than every business
// action across the app - a full action-by-action trail for every agent write is a much larger
// undertaking or was never blocked, this is what genuinely blocked TASK-8.7 (Agent diagnostyczny)
// and TASK-9.3 together. `actor` distinguishes who/what performed the action (a human via the web
// session, the Telegram bot, a cron sweep, etc.) since not every action has a human userId behind
// it.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  actor     String
  action    String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model ClaudeUsageLog {
  id           String   @id @default(cuid())
  scope        String
  model        String
  inputTokens  Int
  outputTokens Int
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([scope, createdAt])
}
